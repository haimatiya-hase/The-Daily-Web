<%- include("../partials/head", { pageTitle }) %>
<%- include("../partials/header", { activePage }) %>

<main>
  <section class="hero container">
    <div class="hero-layout">
      <div class="hero-content">
        <div class="eyebrow"><span class="eyebrow-line"></span>THE DAILY BRIEF</div>
        <p class="hero-kicker">NEWS / SIGNAL / IMPACT</p>
        <h1>החדשות החשובות,<br><span>במקום אחד.</span></h1>
        <p class="hero-copy">פיד חדשות נקי, מהיר ומבוסס תוכן — עם סביבת עבודה שמחברת בין כתבים, עורכים וקוראים.</p>
        <div class="hero-actions">
          <a class="button button-primary" href="#news-feed">לצפייה בפיד <span aria-hidden="true">←</span></a>
          <a class="button button-secondary" href="/login">כניסת צוות <span aria-hidden="true">↗</span></a>
        </div>
        <div class="hero-trust" aria-label="נתוני המערכת">
          <div><strong>24/7</strong><span>NEWS FLOW</span></div>
          <div><strong>500+</strong><span>DEMO STORIES</span></div>
          <div><strong>01</strong><span>SHARED SPACE</span></div>
        </div>
      </div>

      <div class="hero-visual" aria-label="תצוגה גרפית של חדר החדשות">
        <div class="visual-orbit visual-orbit-one"></div>
        <div class="visual-orbit visual-orbit-two"></div>
        <div class="signal-card signal-card-main">
          <div class="signal-card-top"><span class="live-chip"><i></i> LIVE</span><span>NEWS INTELLIGENCE</span></div>
          <div class="signal-headline">THE NEXT<br><em>STORY</em></div>
          <div class="signal-bars" aria-hidden="true">
            <span class="bar-one"></span><span class="bar-two"></span><span class="bar-three"></span><span class="bar-four"></span><span class="bar-five"></span><span class="bar-six"></span><span class="bar-seven"></span>
          </div>
          <div class="signal-card-bottom"><span>EDITORIAL PULSE</span><strong>+ 86.4%</strong></div>
        </div>
        <div class="floating-card floating-card-top"><span class="floating-label">STATUS</span><strong>מערכת עריכה חיה</strong><span class="floating-value">CONNECTED</span></div>
        <div class="floating-card floating-card-bottom"><span class="floating-label">TODAY'S SIGNAL</span><strong>הסיפור הבא מתחיל כאן</strong></div>
      </div>
    </div>
  </section>

  <section class="container content-grid" aria-label="תוכן ראשי">
    <div class="main-column">
      <div class="section-heading" id="news-feed">
        <div>
          <div class="eyebrow">LATEST STORIES</div>
          <h2>כתבות אחרונות</h2>
        </div>
        <span class="status-pill status-live"><i></i> תשתית מוכנה</span>
      </div>

      <form class="filters-card" id="feed-filters" novalidate>
        <label>
          חיפוש
          <input type="search" name="search" placeholder="חיפוש לפי כותרת..." autocomplete="off">
        </label>
        <label>
          קטגוריה
          <select name="category">
            <option value="">כל הקטגוריות</option>
            <option value="news">חדשות</option>
            <option value="culture">תרבות</option>
            <option value="sport">ספורט</option>
          </select>
        </label>
        <label>
          מיון
          <select name="sort">
            <option value="publishedAt">החדשות ביותר</option>
            <option value="popularity">הפופולריות ביותר</option>
          </select>
        </label>
      </form>

      <div class="feed" id="feed" aria-live="polite">
        <article class="empty-state feed-empty">
          <div class="empty-visual" aria-hidden="true"><span></span><span></span><span></span></div>
          <div class="eyebrow">FEED PREVIEW</div>
          <h3>הפיד מתעורר בקרוב</h3>
          <p>תשתית החדשות מחוברת. החיפוש, הסינון, המיון והטעינה האינסופית יופעלו עם חיבור פיד הכתבות.</p>
        </article>
      </div>
      <div class="loading-indicator" id="feed-loading" hidden>טוען כתבות...</div>
    </div>

    <aside class="sidebar" aria-label="סרגל צד">
      <div class="weather-card" id="weather-widget">
        <div class="card-topline"><div class="eyebrow">LOCAL WEATHER</div><span class="live-chip"><i></i> LIVE</span></div>
        <div class="weather-heading"><div><h2>מזג האוויר</h2><p>ירושלים, ישראל</p></div><span class="weather-symbol" aria-hidden="true">☼</span></div>
        <%# Announce changing weather text to screen-reader users. %>
        <div class="weather-content" id="weather-content" aria-live="polite">
          <%# Show a short message while the browser requests current weather. %>
          <p class="weather-status">טוען נתוני מזג אוויר...</p>
        </div>
        <%# Explain that repeated visits reuse the server cache. %>
        <small class="weather-note">הנתונים נשמרים במטמון עד 15 דקות.</small>
      </div>
      <div class="note-card">
        <div class="card-topline"><div class="eyebrow">PROJECT STATUS</div><span class="project-index">01</span></div>
        <h3>שלב 01 — תשתית</h3>
        <p>Express, MVC, EJS, מודלי MongoDB, מסלולים ותיעוד צוות.</p>
        <div class="progress-line" aria-label="שלב ראשון מתוך ארבעה"><span></span></div>
        <small class="progress-label">FOUNDATION LAYER <b>25%</b></small>
        <a href="/api/health">בדיקת חיבור למערכת ←</a>
      </div>
    </aside>
  </section>
</main>

<script src="/js/home.js" defer></script>
<%- include("../partials/footer") %>
