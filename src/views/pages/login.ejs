<%- include("../partials/head", { pageTitle }) %>
<%- include("../partials/header", { activePage }) %>

<main class="container page-shell narrow-shell">
  <section class="form-card">
    <div class="eyebrow">TEAM ACCESS</div>
    <h1>כניסת צוות</h1>
    <p>כתבים ועורכים יתחברו כאן לפי התפקיד שלהם במערכת.</p>
    <form action="/login" method="post">
      <label>
        שם משתמש
        <input type="text" name="username" required autocomplete="username">
      </label>
      <label>
        סיסמה
        <input type="password" name="password" required autocomplete="current-password">
      </label>
      <button class="button button-primary" type="submit">התחברות</button>
    </form>
    <p class="form-note">מנגנון ההזדהות וה-session persistence יתווסף ב-PR הבא.</p>
  </section>
</main>

<%- include("../partials/footer") %>
