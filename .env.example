PORT=3000
MONGODB_URI=mongodb://127.0.0.1:27017/the-daily-web
SESSION_TTL_MINUTES=10080

# Open-Meteo is a free weather service and does not require an API key.
WEATHER_API_URL=https://api.open-meteo.com/v1/forecast
WEATHER_LATITUDE=31.7683
WEATHER_LONGITUDE=35.2137
WEATHER_TIMEZONE=Asia/Jerusalem

# Required only for the demo seed script; never use this value in production.
SEED_PASSWORD=
